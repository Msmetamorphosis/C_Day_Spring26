    <title>Architectural Stabilization of LLMs | C Day Research Showcase</title>
    <meta
      name="description"
      content="Research showcase website for architectural stabilization of LLMs, linked experimental dashboards, and related research including CIPHER, PRISM, SAF, and Chrysalis."
    />
    <style>
      :root {
        --sage: #9caf88;
        --cream: #fff8ee;
        --terracotta: #c9785f;
        --deep-blue: #17304a;
        --burnt-orange: #b85c38;
        --text: #17304a;
        --muted: #5f6f66;
        --border: rgba(23, 48, 74, 0.12);
        --shadow: 0 18px 48px rgba(23, 48, 74, 0.14);
        --radius: 22px;
        --max-width: 1180px;
      }* {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, Arial, Helvetica, sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at top left, rgba(156, 175, 136, 0.24), transparent 30%),
      radial-gradient(circle at 86% 14%, rgba(201, 120, 95, 0.18), transparent 24%),
      radial-gradient(circle at 50% 100%, rgba(184, 92, 56, 0.14), transparent 28%),
      linear-gradient(180deg, #f8f0e4 0%, #f6ebde 45%, #f1e3d4 100%);
    line-height: 1.65;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(calc(100% - 2rem), var(--max-width));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 248, 238, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-wrap {
    min-height: 74px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
  }

  .brand strong {
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .brand span {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .nav a {
    color: var(--deep-blue);
    opacity: 0.8;
    font-size: 0.95rem;
  }

  .nav a:hover {
    color: var(--burnt-orange);
    opacity: 1;
  }

  .hero {
    padding: 5.5rem 0 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: stretch;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: rgba(156, 175, 136, 0.18);
    border: 1px solid rgba(156, 175, 136, 0.35);
    color: var(--deep-blue);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }

  h1,
  h2,
  h3 {
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  h1 {
    font-size: clamp(2.3rem, 6vw, 4.4rem);
    max-width: 12ch;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
  }

  p {
    margin: 0 0 1rem;
  }

  .hero p {
    font-size: 1.05rem;
    color: rgba(23, 48, 74, 0.82);
    max-width: 62ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.88rem 1.2rem;
    font-weight: 700;
    border: 1px solid transparent;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--deep-blue);
    color: var(--cream);
    box-shadow: var(--shadow);
  }

  .btn-secondary {
    background: rgba(255, 248, 238, 0.7);
    border-color: rgba(23, 48, 74, 0.14);
    color: var(--deep-blue);
  }

  .hero-card,
  .card {
    background: rgba(255, 248, 238, 0.9);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .hero-card {
    padding: 1.4rem;
    display: grid;
    gap: 1rem;
  }

  .hero-stat {
    padding: 1rem;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(156, 175, 136, 0.18), rgba(255, 248, 238, 0.75));
    border: 1px solid rgba(156, 175, 136, 0.24);
  }

  .hero-stat strong {
    display: block;
    font-size: 1.8rem;
    color: var(--burnt-orange);
    margin-bottom: 0.3rem;
  }

  .section {
    padding: 1.4rem 0 3.6rem;
  }

  .section-head {
    max-width: 72ch;
    margin-bottom: 1.6rem;
  }

  .grid-3,
  .grid-2 {
    display: grid;
    gap: 1.25rem;
  }

  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card {
    padding: 1.4rem;
  }

  .card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
  }

  .tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 0.8rem;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
  }

  .link-card a.inline-link,
  .bio a.inline-link,
  .research-links a.inline-link {
    color: var(--burnt-orange);
    font-weight: 700;
  }

  .link-card a.inline-link:hover,
  .bio a.inline-link:hover,
  .research-links a.inline-link:hover {
    color: var(--deep-blue);
  }

  .bio-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 1.25rem;
  }

  .bio-highlight {
    background: linear-gradient(180deg, rgba(23, 48, 74, 0.96), rgba(37, 67, 97, 0.96));
    color: var(--cream);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }

  .bio-highlight p,
  .bio-highlight li {
    color: rgba(255, 248, 238, 0.88);
  }

  ul {
    padding-left: 1.2rem;
    margin: 0.65rem 0 0;
  }

  .footer {
    padding: 1.5rem 0 3rem;
    color: rgba(23, 48, 74, 0.72);
  }

  .footer-inner {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .grid-3,
    .grid-2,
    .bio-layout {
      grid-template-columns: 1fr;
    }

    .nav-wrap {
      padding: 0.8rem 0;
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 4.5rem;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
